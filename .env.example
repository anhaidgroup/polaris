# Copy this file to .env (same folder) and fill in your credentials.
# .env is gitignored — it never leaves your machine.

# Hugging Face token — needed to download the Llama 3.1 model
# (create one at https://huggingface.co/settings/tokens after accepting
# the meta-llama/Llama-3.1-8B-Instruct license; note unsloth may fetch
# its own pre-quantized 4-bit build of the model, ~6 GB)
HF_TOKEN=

# AWS Bedrock bearer token — used by name expansion (expand_names)
AWS_BEARER_TOKEN_BEDROCK=

# Bedrock region (optional; default us-east-1)
# AWS_REGION=us-east-1
